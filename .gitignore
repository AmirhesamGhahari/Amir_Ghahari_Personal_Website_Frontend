# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── Next.js build output ─────────────────────────────────────────────────────
.next/
out/

# ── Next.js cache ────────────────────────────────────────────────────────────
.next/cache/

# ── Environment variables (never commit secrets) ──────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Plasmic auth token (contains your Plasmic credentials) ───────────────────
.plasmic/
plasmic-auth.json

# ── macOS system files ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editor files ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Debug logs ───────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── AWS SAM / CDK local artifacts (not used here, but common on AWS projects) ─
.aws-sam/
cdk.out/
